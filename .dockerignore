# Secrets: never bake real .env into an image layer. .gitignore does NOT
# apply to Docker build context — only this file does (CR-01).
.env
.env.*
!.env.example

# VCS and planning artifacts
.git
.gitignore
.planning/

# Local data corpus and caches (rebuilt at runtime / bind-mounted)
data/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Virtualenvs
.venv
venv/
