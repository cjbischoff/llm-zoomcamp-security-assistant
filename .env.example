# OpenAI API
OPENAI_API_KEY=sk-...

# Postgres (for dlt and query logging)
DLT_POSTGRES_USER=postgres
DLT_POSTGRES_PASSWORD=password
DLT_POSTGRES_HOST=localhost
DLT_POSTGRES_PORT=5432
DLT_POSTGRES_DATABASE=security_rag

# Postgres (alternative format for SQLAlchemy)
POSTGRES_URL=postgresql://postgres:password@localhost:5432/security_rag

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=security_rag

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI -> API base URL. Local default below; the compose `ui` service
# overrides this to http://app:8000 (compose service name) for in-network access.
API_URL=http://localhost:8000

# Streamlit
STREAMLIT_PORT=8501

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
